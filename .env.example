DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=unclewestie
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=replace-with-a-64-character-random-secret-string-for-production-use
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
NEXT_PUBLIC_SITE_URL=https://unclewestieestudios.co.ke
TRUST_PROXY=true
REDIS_URL=

# One-time database setup (visit /api/setup/migrate?token=... on the live server, then remove)
MIGRATION_SECRET=replace-with-a-long-random-secret-before-deploy
